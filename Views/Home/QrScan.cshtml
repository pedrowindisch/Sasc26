@{
    Layout = null;
    var eventSlug = ViewBag.EventSlug as string ?? "";
    var lectureId = ViewBag.LectureId as int? ?? 0;
    var email = ViewBag.Email as string ?? "";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Escaneie o QR Code</title>
    <link rel="stylesheet" href="~/css/bulmaswatch.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #000; min-height: 100vh; margin: 0; display: flex; flex-direction: column; }
        .scan-container { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 16px; position: relative; }
        #reader-wrapper { width: 100%; max-width: 360px; aspect-ratio: 1; position: relative; background: #111; border-radius: 24px; overflow: hidden; }
        #reader { width: 100%; height: 100%; position: relative; }
        #reader video { width: 100% !important; height: 100% !important; object-fit: cover !important; position: absolute !important; top: 0 !important; left: 0 !important; }
        #reader__dashboard_section { display: none !important; }
        #reader__scan_region { display: flex !important; align-items: center !important; justify-content: center !important; width: 100% !important; height: 100% !important; }
        #reader__dashboard_section_csr { display: none !important; }
        .reader__scan_region, .reader__dashboard_section, .reader__dashboard_section_sw_link { display: none !important; }
        .overlay-frame { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 60%; height: 60%; border: 3px solid rgba(255,255,255,0.4); border-radius: 16px; pointer-events: none; z-index: 10; }
        .status-area { position: absolute; bottom: 0; left: 0; right: 0; padding: 20px; text-align: center; z-index: 10; }
        .status-msg { color: #fff; font-size: 1rem; font-weight: 500; text-shadow: 0 2px 8px rgba(0,0,0,0.8); }
        .status-msg.success { color: #34d399; }
        .status-msg.error { color: #f87171; }
        .header-bar { display: flex; align-items: center; gap: 12px; padding: 16px; background: transparent; position: absolute; top: 0; left: 0; right: 0; z-index: 20; }
        .btn-back { background: rgba(255,255,255,0.15); backdrop-filter: blur(8px); color: #fff; border: none; width: 40px; height: 40px; border-radius: 50%; font-size: 1.3rem; cursor: pointer; display: flex; align-items: center; justify-content: center; text-decoration: none; }
        .btn-back:hover { background: rgba(255,255,255,0.25); }
        .header-title { color: #fff; font-size: 0.95rem; font-weight: 600; }
        .result-overlay { display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.85); z-index: 30; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 32px; }
        .result-overlay.show { display: flex; }
        .result-icon { font-size: 3rem; margin-bottom: 16px; }
        .result-title { color: #fff; font-size: 1.3rem; font-weight: 700; margin-bottom: 8px; }
        .result-msg { color: rgba(255,255,255,0.7); font-size: 0.95rem; margin-bottom: 24px; }
        .result-close { background: #fff; color: #000; border: none; padding: 12px 32px; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer; }
        .shutter { display: none; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: #fff; z-index: 25; animation: shutterAnim 0.3s ease-out; }
        .shutter.go { display: block; }
        @@keyframes shutterAnim { 0% { opacity: 1; } 100% { opacity: 0; } }
    </style>
</head>
<body>
    <div class="scan-container">
        <div class="header-bar">
            <a href="javascript:history.back()" class="btn-back">&larr;</a>
            <div class="header-title">Escaneie o QR Code</div>
        </div>

        <div id="reader-wrapper">
            <div id="reader"></div>
            <div class="overlay-frame"></div>
            <div class="status-area"><div class="status-msg" id="statusMsg">Aguardando câmera...</div></div>
            <div class="result-overlay" id="resultOverlay">
                <div class="result-icon" id="resultIcon">✅</div>
                <div class="result-title" id="resultTitle">Check-in realizado!</div>
                <div class="result-msg" id="resultMsg">Sua presença foi registrada.</div>
                <button class="result-close" onclick="goBack()">OK</button>
            </div>
            <div class="shutter" id="shutter"></div>
        </div>
    </div>

    <div id="scanner-status" style="display:none" data-ready="false"></div>

    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script>
        var lectureId = @lectureId;
        var email = "@email";
        var eventSlug = "@eventSlug";
        var scanned = false;
        var scanner = null;
        var readerEl = document.getElementById('reader');
        var statusMsg = document.getElementById('statusMsg');

        function setStatus(msg, type) {
            statusMsg.textContent = msg;
            statusMsg.className = 'status-msg' + (type ? ' ' + type : '');
        }

        function showResult(icon, title, msg) {
            document.getElementById('resultIcon').textContent = icon;
            document.getElementById('resultTitle').textContent = title;
            document.getElementById('resultMsg').textContent = msg;
            document.getElementById('resultOverlay').classList.add('show');
        }

        function goBack() { history.back(); }

        function shutterFlash() {
            var s = document.getElementById('shutter');
            s.classList.add('go');
            setTimeout(function() { s.classList.remove('go'); }, 400);
        }

        function onScanSuccess(decodedText) {
            if (scanned) return;
            scanned = true;
            shutterFlash();

            var parts = decodedText.split(':');
            var scannedLectureId = parseInt(parts.length >= 3 ? parts[parts.length - 2] : '0');
            var token = parts.length >= 3 ? parts[parts.length - 1] : decodedText;

            if (scannedLectureId !== lectureId) {
                setStatus('QR Code não corresponde a esta palestra', 'error');
                setTimeout(function() { scanned = false; }, 2000);
                return;
            }

            setStatus('QR reconhecido! Fazendo check-in...', 'success');

            fetch('/' + eventSlug + '/Home/SubmitQrCheckIn', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    email: email,
                    lectureId: lectureId,
                    token: token,
                    fullName: '',
                    course: '',
                    shift: '',
                    phase: 0
                })
            })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    showResult('✅', 'Check-in realizado!', data.message || 'Sua presença foi registrada com sucesso.');
                    if (scanner) { scanner.stop().catch(function(){}); }
                } else {
                    showResult('❌', 'Erro no check-in', data.message || 'Não foi possível registrar sua presença.');
                    setTimeout(function() { scanned = false; }, 3000);
                }
            })
            .catch(function() {
                showResult('❌', 'Erro de conexão', 'Verifique sua internet e tente novamente.');
                setTimeout(function() { scanned = false; }, 3000);
            });
        }

        function startScanner() {
            scanner = new Html5Qrcode("reader");
            scanner.start(
                { facingMode: "environment" },
                { fps: 10, qrbox: { width: 220, height: 220 } },
                onScanSuccess
            ).then(function() {
                setStatus('Aponte a câmera para o QR Code');
                document.getElementById('scanner-status').dataset.ready = 'true';
            }).catch(function(err) {
                setStatus('Erro ao acessar câmera: ' + err, 'error');
            });
        }

        window.addEventListener('load', function() {
            setTimeout(startScanner, 300);
        });

        window.addEventListener('beforeunload', function() {
            if (scanner) { scanner.stop().catch(function(){}); }
        });
    </script>
</body>
</html>
