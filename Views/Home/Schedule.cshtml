@{
    ViewData["Title"] = "Programação";
    var ev = ViewBag.Event as Sasc26.Models.Event;
    var primaryColor = ev?.PrimaryColor ?? "#113D76";
    var accentColor = ev?.AccentColor ?? "#2EBDEF";
    var backgroundColor = ev?.BackgroundColor ?? "#f5f5f5";
    var eventName = ev?.Name ?? "SASC 26";
    var eventSubtitle = ev?.Subtitle ?? "";
    var eventSlug = ev?.Slug ?? "";
}

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/bulmaswatch.min.css">
    <style>
        body { font-family: 'Inter', sans-serif; background: @backgroundColor; min-height: 100vh; display: flex; align-items: center; justify-content: center; }
        .card-wrapper { width: 100%; max-width: 560px; padding: 0 16px; }
        .event-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); overflow: hidden; }
        .event-header { background: @primaryColor; padding: 28px 24px 20px; text-align: center; }
        .event-header img.logo { width: 56px; height: 56px; margin-bottom: 12px; }
        .event-header h1 { font-size: 1.25rem; font-weight: 700; color: #fff; margin: 0; }
        .event-header p { font-size: 0.75rem; color: rgba(255,255,255,0.6); margin: 4px 0 0; text-transform: uppercase; letter-spacing: 0.05em; }
        .event-body { padding: 8px 24px 28px; }
        .step-section { display: none; padding-top: 16px; }
        .step-section.active { display: block; }

        .day-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 18px; }
        .day-tab { padding: 8px 14px; border-radius: 100px; font-size: 0.78rem; font-weight: 600; background: #fff; color: #666; border: 1.5px solid #e0e0e0; cursor: pointer; transition: all 0.2s; white-space: nowrap; }
        .day-tab:hover { border-color: @accentColor; color: @primaryColor; }
        .day-tab.active { background: @primaryColor; color: #fff; border-color: @primaryColor; }
        .day-tab .tab-count { display: inline-block; background: rgba(0,0,0,0.15); border-radius: 100px; padding: 0 6px; font-size: 0.65rem; margin-left: 4px; }
        .day-tab.active .tab-count { background: rgba(255,255,255,0.25); }

        .lecture-card { background: #fff; border-radius: 10px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); padding: 16px 20px; margin-bottom: 12px; cursor: pointer; transition: border-color 0.2s; border: 2px solid transparent; }
        .lecture-card:hover { border-color: @accentColor; }
        .lecture-card.selected { border-color: @primaryColor; background: #f8faff; }
        .lecture-card.disabled { opacity: 0.6; cursor: default; pointer-events: none; }
        .lecture-card .l-title { font-size: 0.9rem; font-weight: 700; color: #1a1a1a; margin-bottom: 2px; }
        .lecture-card .l-speaker { font-size: 0.8rem; color: #666; }

        .pre-reg-badge { display: inline-block; padding: 2px 8px; border-radius: 100px; font-size: 0.65rem; font-weight: 600; margin-top: 6px; }
        .pre-reg-badge.open { background: #ecfdf5; color: #059669; }
        .pre-reg-badge.closed { background: #f3f4f6; color: #9ca3af; }
        .pre-reg-badge.registered { background: #eff6ff; color: #1d4ed8; }

        .check-icon { float: right; width: 22px; height: 22px; border-radius: 50%; border: 2px solid #ddd; display: flex; align-items: center; justify-content: center; font-size: 0.7rem; color: transparent; transition: all 0.2s; margin-top: 2px; }
        .lecture-card.selected .check-icon { border-color: @primaryColor; background: @primaryColor; color: #fff; }
        .lecture-card.disabled .check-icon { border-color: transparent; background: transparent; color: transparent; }

        .input:focus { border-color: @accentColor; box-shadow: 0 0 0 3px rgba(46,189,239,0.15); }
        .button.is-brand { background-color: @primaryColor; color: #fff; }
        .button.is-brand:hover { background-color: @primaryColor; opacity: 0.85; color: #fff; }
        .button.is-brand:disabled { background-color: #bbb; color: #fff; }

        .otp-input { letter-spacing: 6px; font-size: 1.25rem; font-weight: 600; text-align: center; }
        .msg-error { background: #fef2f2; color: #b91c1c; padding: 10px 14px; border-radius: 8px; font-size: 0.85rem; margin-bottom: 12px; }
        .msg-success { background: #ecfdf5; color: #047857; padding: 12px 14px; border-radius: 8px; font-size: 0.85rem; margin-bottom: 12px; line-height: 1.5; }
        .msg-info { padding: 10px 14px; border-radius: 8px; font-size: 0.85rem; margin-bottom: 12px; }
        .empty-state { text-align: center; padding: 40px 20px; color: #bbb; font-size: 0.85rem; }

        .section-label { font-size: 0.7rem; font-weight: 600; color: #bbb; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 12px; }
        .back-link { display: inline-block; margin-top: 12px; font-size: 0.8rem; color: #aaa; cursor: pointer; }
        .back-link:hover { color: #555; }
        .nav-links { text-align: center; margin-top: 24px; }
        .nav-links a { font-size: 0.8rem; color: #aaa; }
        .nav-links a:hover { color: #555; }
        .submit-bar { background: #fff; padding: 14px 0; border-top: 1px solid #eee; margin-top: 8px; }
        .shift-divider { margin: 20px 0 10px; padding-bottom: 6px; border-bottom: 2px solid @primaryColor; display: flex; align-items: baseline; gap: 8px; }
        .shift-divider .shift-label { font-size: 0.78rem; font-weight: 700; color: @primaryColor; text-transform: uppercase; letter-spacing: 0.03em; }
        .shift-divider .shift-hint { font-size: 0.65rem; color: #999; font-weight: 400; }
    </style>
}

<div class="card-wrapper">
    <div class="event-card">
        <div class="event-header">
            <img class="logo" src="@ev.LogoUrl(Url)" alt="@(ev?.Name ?? "DASC")">
            <h1>@eventName - Programação</h1>
            <p>@eventSubtitle</p>
        </div>
        <div class="event-body">
    <div id="messageArea"></div>

    <div class="step-section active" id="stepEmail">
        <div class="field">
            <label class="label is-small has-text-grey">Seu e-mail</label>
            <div class="control"><input class="input" type="email" id="emailInput" placeholder="seu.nome@furb.br" autocomplete="email" autofocus></div>
        </div>
        <div class="field" style="margin-top:14px;">
            <div class="control"><button class="button is-brand is-fullwidth" id="btnContinue" onclick="loadScheduleWithEmail()">Ver programação</button></div>
        </div>
        <div class="nav-links"><a href="/@eventSlug">&#8592; Registrar presença</a></div>
    </div>

    <div class="step-section" id="stepSchedule">
        <p class="email-hint" id="emailDisplay" style="font-size:0.8rem;color:#999;margin-bottom:14px;"></p>
        <div id="dayTabs" class="day-tabs"></div>
        <div id="lectureContainer"><div class="empty-state">Selecione um dia acima.</div></div>
        <div class="submit-bar">
            <button class="button is-brand is-fullwidth" id="btnSubmit" onclick="goToForm()" disabled>Avançar</button>
        </div>
        <a class="back-link" onclick="goBackToEmail()">&#8592; Voltar</a>
    </div>

    <div class="step-section" id="stepForm">
        <div id="formConfigHeader">
            <p style="font-size:0.85rem;color:#333;margin-bottom:16px;" id="selectedLecturesSummary"></p>
        </div>
        <div id="formMsg"></div>
        <div id="profileFields">
            <div class="field"><label class="label is-small has-text-grey">Nome completo</label><div class="control"><input class="input" type="text" id="fullNameInput" placeholder="João da Silva" autocomplete="name"></div></div>
            <div class="field"><label class="label is-small has-text-grey">Curso</label><div class="control"><div class="select is-fullwidth"><select id="courseSelect"><option value="">Carregando...</option></select></div></div></div>
            <div class="field"><label class="label is-small has-text-grey">Turno</label><div class="control"><div class="select is-fullwidth"><select id="shiftSelect"><option value="">Selecione</option><option value="Matutino">Matutino</option><option value="Noturno">Noturno</option></select></div></div></div>
            <div class="field"><label class="label is-small has-text-grey">Fase</label><div class="control"><div class="select is-fullwidth"><select id="phaseSelect"><option value="">-</option></select></div></div></div>
        </div>
        <div id="customFormArea" style="display:none;margin-top:16px;padding-top:16px;border-top:1px solid #eee;"></div>
        <div class="field" style="margin-top:20px;">
            <div class="control"><button class="button is-brand is-fullwidth" id="btnSubmitForm" onclick="submitPreRegistrationWithForm()">Concluir inscrição</button></div>
        </div>
        <a class="back-link" onclick="goBackToSchedule()">&#8592; Voltar</a>
    </div>

    <div class="step-section" id="stepOtp">
        <div class="msg-info">Enviamos um código de verificação para <strong id="otpEmailDisplay"></strong>.</div>
        <div id="otpMsg"></div>
        <div class="field">
            <label class="label is-small has-text-grey">Código de verificação</label>
            <div class="control"><input class="input otp-input" type="text" id="otpInput" maxlength="6" inputmode="numeric" pattern="[0-9]*" placeholder="000000" autocomplete="one-time-code"></div>
        </div>
        <div class="field" style="margin-top:14px;">
            <div class="control"><button class="button is-brand is-fullwidth" id="btnVerifyOtp" onclick="verifyOtp()">Confirmar inscrição</button></div>
        </div>
        <a class="back-link" onclick="goBackToForm()">&#8592; Voltar</a>
    </div>

    <div class="step-section" id="stepSuccess">
        <div class="msg-success has-text-centered" id="successMessage" style="padding:20px;font-size:0.9rem;"></div>
        <div style="text-align:center;margin-top:16px;">
            <button class="button is-brand" onclick="resetForm()">Nova inscrição</button>
        </div>
    </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const baseUrl = '/@eventSlug';
    let currentEmail = '';
    let selectedIds = {};
    let allLectures = [];
    let activeDay = null;
    let isEventWide = false;
    let hasEventWideRegistration = false;
    let preRegConfig = null;
    let coursesList = [];

    async function loadCourses() {
        try {
            const res = await fetch(baseUrl + '/Home/GetCourses');
            const data = await res.json();
            if (data.success && data.courses) {
                coursesList = data.courses;
                const sel = document.getElementById('courseSelect');
                sel.innerHTML = '<option value="">Selecione</option>' +
                    coursesList.map(c => '<option value="' + esc(c.name) + '">' + esc(c.name) + '</option>').join('');
            } else {
                document.getElementById('courseSelect').innerHTML = '<option value="">Selecione</option>';
            }
        } catch {
            document.getElementById('courseSelect').innerHTML = '<option value="">Selecione</option>';
        }
    }

    function updatePhaseOptions() {
        const courseName = document.getElementById('courseSelect').value;
        const course = coursesList.find(c => c.name === courseName);
        const max = course ? course.numberOfSemesters : 0;
        const sel = document.getElementById('phaseSelect');
        const currentVal = sel.value;
        let html = '<option value="">-</option>';
        for (let i = 1; i <= max; i++) { html += '<option value="' + i + '">' + i + '</option>'; }
        sel.innerHTML = html;
        if (currentVal && parseInt(currentVal) <= max) sel.value = currentVal;
    }

    document.addEventListener('DOMContentLoaded', function() {
        loadCourses();
        document.getElementById('courseSelect').addEventListener('change', updatePhaseOptions);
    });

    function showMessage(t, type) { document.getElementById('messageArea').innerHTML = t ? `<div class="msg-${type}">${t}</div>` : ''; }
    function showFormMsg(t, type) { document.getElementById('formMsg').innerHTML = t ? `<div class="msg-${type}">${t}</div>` : ''; }
    function clearMessage() { document.getElementById('messageArea').innerHTML = ''; }
    function clearFormMsg() { document.getElementById('formMsg').innerHTML = ''; }
    function showStep(s) { document.querySelectorAll('.step-section').forEach(el => el.classList.remove('active')); document.getElementById('step' + s).classList.add('active'); }
    function esc(s) { const d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }
    function escA(s) { return (s||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;'); }
    function fmtDate(iso) { const [y,m,d] = iso.split('-'); const dt = new Date(y, m-1, d); return dt.toLocaleDateString('pt-BR', { weekday: 'short', day: '2-digit', month: 'short' }); }
    function getFileAccept(f) {
        if (f.fileAccept === 'pdf') return '.pdf,application/pdf';
        if (f.fileAccept === 'image') return 'image/*';
        if (f.fileAccept === 'pdf_image') return '.pdf,application/pdf,image/*';
        return '*/*';
    }

    async function loadScheduleWithEmail() {
        const email = document.getElementById('emailInput').value.trim();
        if (!email) { showMessage('Informe seu e-mail.', 'error'); return; }
        currentEmail = email;
        clearMessage();
        const btn = document.getElementById('btnContinue');
        btn.classList.add('is-loading'); btn.disabled = true;
        try {
            const res = await fetch(baseUrl + `/Home/GetSchedule?email=${encodeURIComponent(email)}`);
            const data = await res.json();
            if (!data.success) { showMessage('Erro ao carregar.', 'error'); return; }
            allLectures = data.lectures || [];
            isEventWide = data.isEventWide || false;
            hasEventWideRegistration = data.hasEventWideRegistration || false;
            selectedIds = {};
            activeDay = null;
            document.getElementById('emailDisplay').textContent = email;

            if (isEventWide) {
                renderEventWideUI();
            } else {
                renderDayTabs();
            }
            showStep('Schedule');
        } catch { showMessage('Erro de conexão.', 'error'); }
        finally { btn.classList.remove('is-loading'); btn.disabled = false; }
    }

    function renderDayTabs() {
        const tabs = document.getElementById('dayTabs');
        const days = [...new Set(allLectures.map(l => l.date))].sort();
        if (days.length === 0) {
            tabs.innerHTML = '';
            document.getElementById('lectureContainer').innerHTML = '<div class="empty-state">Nenhuma palestra cadastrada ainda.</div>';
            return;
        }
        tabs.innerHTML = days.map(d => {
            const slotsWithReg = new Set(allLectures.filter(l => l.date === d && l.alreadyRegistered).map(l => String(l.timeSlotId)));
            const slotsWithSel = new Set(Object.keys(selectedIds).filter(tsId => {
                const l = allLectures.find(x => String(x.timeSlotId) === String(tsId));
                return l && l.date === d;
            }).map(String));
            const covered = new Set([...slotsWithReg, ...slotsWithSel]);
            const count = covered.size;
            return `<div class="day-tab${activeDay === d ? ' active' : ''}" onclick="selectDay('${d}')">
                ${fmtDate(d)}${count > 0 ? `<span class="tab-count">${count}</span>` : ''}
            </div>`;
        }).join('');
        if (!activeDay) selectDay(days[0]);
        else renderDayLectures();
    }

    function selectDay(day) {
        activeDay = day;
        document.querySelectorAll('.day-tab').forEach(t => t.classList.remove('active'));
        const tabs = document.querySelectorAll('.day-tab');
        const days = [...new Set(allLectures.map(l => l.date))].sort();
        const idx = days.indexOf(day);
        if (idx >= 0 && tabs[idx]) tabs[idx].classList.add('active');
        renderDayLectures();
    }

    function renderDayLectures() {
        const container = document.getElementById('lectureContainer');
        if (!activeDay) { container.innerHTML = '<div class="empty-state">Selecione um dia acima.</div>'; return; }
        const dayLectures = allLectures.filter(l => l.date === activeDay);
        if (dayLectures.length === 0) { container.innerHTML = '<div class="empty-state">Nenhuma palestra neste dia.</div>'; return; }

        const shiftGroups = {};
        for (const l of dayLectures) {
            const key = l.timeSlotId;
            if (!shiftGroups[key]) shiftGroups[key] = { shift: l.shift, label: l.timeSlotLabel, lectures: [] };
            shiftGroups[key].lectures.push(l);
        }

        let html = '';
        for (const [tsId, group] of Object.entries(shiftGroups)) {
            html += `<div class="shift-divider"><span class="shift-label">${esc(group.shift)}</span><span class="shift-hint">${esc(group.label)} &middot; Escolha até 1</span></div>`;
            for (const l of group.lectures) {
                const isReg = l.alreadyRegistered;
                const isOpen = l.isPreRegistrationEnabled;
                let badge = '';
                let cardClass = 'lecture-card';
                if (isReg) { badge = '<span class="pre-reg-badge registered">Inscrito</span>'; }
                else if (isOpen) { badge = '<span class="pre-reg-badge open">Inscrições Abertas</span>'; }
                else { badge = '<span class="pre-reg-badge closed">Inscrições Encerradas</span>'; cardClass += ' disabled'; }

                const sel = String(selectedIds[tsId]) === String(l.id);
                if (sel) cardClass += ' selected';

                html += `<div class="${cardClass}" data-id="${l.id}" data-ts="${tsId}" ${isOpen ? `onclick="toggleLecture(${l.id}, ${tsId})"` : ''}>
                    <div class="check-icon">&#10003;</div>
                    <div class="l-title">${esc(l.title)}</div>
                    <div class="l-speaker">${esc(l.speaker)}</div>
                    ${badge}
                </div>`;
            }
        }
        container.innerHTML = html;
        updateSubmitBtn();
    }

    function toggleLecture(id, tsId) {
        const key = String(tsId);
        const prev = selectedIds[key] !== undefined ? String(selectedIds[key]) : undefined;
        if (prev === String(id)) {
            delete selectedIds[key];
        } else {
            selectedIds[key] = id;
        }
        updateSubmitBtn();
        renderDayLectures();
        renderDayTabsCountsOnly();
    }

    function renderDayTabsCountsOnly() {
        const tabs = document.getElementById('dayTabs');
        const days = [...new Set(allLectures.map(l => l.date))].sort();
        if (days.length === 0) return;
        tabs.innerHTML = days.map(d => {
            const slotsWithReg = new Set(allLectures.filter(l => l.date === d && l.alreadyRegistered).map(l => String(l.timeSlotId)));
            const slotsWithSel = new Set(Object.keys(selectedIds).filter(s => {
                const l = allLectures.find(x => String(x.timeSlotId) === String(s));
                return l && l.date === d;
            }).map(String));
            const covered = new Set([...slotsWithReg, ...slotsWithSel]);
            const count = covered.size;
            return `<div class="day-tab${activeDay === d ? ' active' : ''}" onclick="selectDay('${d}')">
                ${fmtDate(d)}${count > 0 ? `<span class="tab-count">${count}</span>` : ''}
            </div>`;
        }).join('');
    }

    function updateSubmitBtn() {
        const btn = document.getElementById('btnSubmit');
        const hasChanges = Object.keys(selectedIds).length > 0;
        btn.disabled = !hasChanges;
        const count = Object.keys(selectedIds).length;
        btn.textContent = count > 0 ? `Avançar (${count})` : 'Avançar';
    }

    function renderEventWideUI() {
        document.getElementById('dayTabs').innerHTML = '';
        const container = document.getElementById('lectureContainer');
        if (hasEventWideRegistration) {
            container.innerHTML = `
                <div class="msg-success has-text-centered" style="padding:20px;">
                    <strong>Você já está inscrito neste evento!</strong>
                </div>`;
            document.getElementById('btnSubmit').disabled = true;
            document.getElementById('btnSubmit').textContent = 'Já inscrito';
        } else {
            container.innerHTML = `
                <div style="text-align:center;padding:20px 0;">
                    <p style="font-size:0.9rem;margin-bottom:16px;">Inscreva-se no evento completo para garantir sua vaga.</p>
                    <button class="button is-brand is-fullwidth" onclick="goToForm()" style="max-width:300px;margin:0 auto;">
                        Inscrever-se no evento
                    </button>
                </div>`;
            document.getElementById('btnSubmit').style.display = 'none';
        }
    }

    async function goToForm() {
        clearMessage();
        const btn = document.getElementById('btnSubmit');
        if (!isEventWide) {
            const ids = Object.values(selectedIds);
            if (ids.length === 0) { showMessage('Selecione pelo menos uma palestra.', 'error'); return; }
        }
        btn.classList.add('is-loading'); btn.disabled = true;
        try {
            if (coursesList.length === 0) await loadCourses();
            const res = await fetch(baseUrl + `/Home/GetPreRegistrationConfig?email=${encodeURIComponent(currentEmail)}`);
            const data = await res.json();
            preRegConfig = data.config || { isFormEnabled: false, formFields: [], message: '' };

            const profile = data.profile;
            if (profile && profile.found) {
                document.getElementById('fullNameInput').value = profile.fullName || '';
                document.getElementById('courseSelect').value = profile.course || '';
                updatePhaseOptions();
                document.getElementById('shiftSelect').value = profile.shift || '';
                if (profile.phase) document.getElementById('phaseSelect').value = profile.phase;
            } else {
                document.getElementById('fullNameInput').value = '';
                document.getElementById('courseSelect').value = '';
                updatePhaseOptions();
                document.getElementById('shiftSelect').value = '';
                document.getElementById('phaseSelect').value = '';
            }

            renderCustomForm();

            let summary = '';
            if (isEventWide) {
                summary = '<strong>Inscrição no evento completo</strong>';
            } else {
                const selectedLectures = allLectures.filter(l => Object.values(selectedIds).includes(l.id));
                const names = selectedLectures.map(l => esc(l.title)).join(', ');
                summary = `<strong>Palestras selecionadas:</strong> ${names}`;
            }
            document.getElementById('selectedLecturesSummary').innerHTML = summary;

            clearFormMsg();
            showStep('Form');
        } catch { showMessage('Erro ao carregar formulário.', 'error'); }
        finally { btn.classList.remove('is-loading'); btn.disabled = false; }
    }

    function renderCustomForm() {
        const area = document.getElementById('customFormArea');
        if (!preRegConfig || !preRegConfig.isFormEnabled || !preRegConfig.formFields || preRegConfig.formFields.length === 0) {
            area.style.display = 'none';
            return;
        }
        area.style.display = 'block';

        let html = `<h3 style="font-size:0.9rem;font-weight:700;color:#1a1a1a;margin:0 0 8px;">${esc(preRegConfig.formTitle || 'Informações adicionais')}</h3>`;
        if (preRegConfig.formDescription) {
            html += `<p style="font-size:0.8rem;color:#666;margin-bottom:16px;">${esc(preRegConfig.formDescription)}</p>`;
        }

        preRegConfig.formFields.forEach((f, i) => {
            const req = f.required ? '<span style="color:#b91c1c;">*</span>' : '';
            html += `<div class="field"><label class="label is-small has-text-grey">${esc(f.label)} ${req}</label>`;
            if (f.type === 'select') {
                html += `<div class="control"><div class="select is-fullwidth is-small"><select id="preField_${i}"><option value="">Selecione</option>`;
                (f.options || []).forEach(o => { html += `<option value="${escA(o)}">${esc(o)}</option>`; });
                html += '</select></div></div>';
            } else if (f.type === 'textarea') {
                html += `<div class="control"><textarea class="textarea is-small" id="preField_${i}" rows="3" placeholder="${escA(f.placeholder || '')}"></textarea></div>`;
            } else if (f.type === 'date') {
                html += `<div class="control"><input class="input is-small" type="date" id="preField_${i}"></div>`;
            } else if (f.type === 'arquivo') {
                html += `<div class="control"><input class="input is-small" type="file" id="preField_${i}" accept="${getFileAccept(f)}"><p style="font-size:0.7rem;color:#888;margin-top:4px;">Máx ${f.fileMaxSizeMb||10}MB</p></div>`;
            } else {
                html += `<div class="control"><input class="input is-small" type="${f.type === 'email' ? 'email' : 'text'}" id="preField_${i}" placeholder="${escA(f.placeholder || '')}"></div>`;
            }
            html += '</div>';
        });

        area.innerHTML = html;
    }

    async function submitPreRegistrationWithForm() {
        clearFormMsg();
        const fullName = document.getElementById('fullNameInput').value.trim();
        const course = document.getElementById('courseSelect').value;
        const shift = document.getElementById('shiftSelect').value;
        const phase = parseInt(document.getElementById('phaseSelect').value) || 0;

        if (!fullName) { showFormMsg('Informe seu nome completo.', 'error'); return; }
        if (!course) { showFormMsg('Selecione o curso.', 'error'); return; }
        if (!shift) { showFormMsg('Selecione o turno.', 'error'); return; }
        if (phase < 1) { showFormMsg('Selecione a fase.', 'error'); return; }

        const hasFile = preRegConfig && preRegConfig.isFormEnabled && preRegConfig.formFields && preRegConfig.formFields.some(f => f.type === 'arquivo');
        let formResponses = [];
        let fileMap = {};
        if (preRegConfig && preRegConfig.isFormEnabled && preRegConfig.formFields) {
            for (let i = 0; i < preRegConfig.formFields.length; i++) {
                const f = preRegConfig.formFields[i];
                const el = document.getElementById('preField_' + i);
                if (f.type === 'arquivo') {
                    const file = el && el.files ? el.files[0] : null;
                    if (f.required && !file) { showFormMsg(`Selecione o arquivo "${f.label}".`, 'error'); return; }
                    if (file) {
                        const maxMb = f.fileMaxSizeMb || 10;
                        if (file.size > maxMb * 1024 * 1024) { showFormMsg(`Arquivo "${f.label}" excede ${maxMb}MB.`, 'error'); return; }
                        const accept = f.fileAccept || 'any';
                        const type = (file.type || '').toLowerCase();
                        if (accept === 'pdf' && type !== 'application/pdf') { showFormMsg(`Arquivo "${f.label}" deve ser PDF.`, 'error'); return; }
                        if (accept === 'image' && !type.startsWith('image/')) { showFormMsg(`Arquivo "${f.label}" deve ser imagem.`, 'error'); return; }
                        if (accept === 'pdf_image' && !(type === 'application/pdf' || type.startsWith('image/'))) { showFormMsg(`Arquivo "${f.label}" deve ser PDF ou imagem.`, 'error'); return; }
                        fileMap[i] = file;
                    }
                    formResponses.push({ label: f.label, value: '' });
                } else {
                    const val = el ? el.value.trim() : '';
                    if (f.required && !val) { showFormMsg(`Preencha o campo "${f.label}".`, 'error'); return; }
                    formResponses.push({ label: f.label, value: val });
                }
            }
        }

        const btn = document.getElementById('btnSubmitForm');
        btn.classList.add('is-loading'); btn.disabled = true;

        const ids = isEventWide ? [] : Object.values(selectedIds);

        try {
            let res;
            if (hasFile) {
                const fd = new FormData();
                fd.append('email', currentEmail);
                fd.append('lectureIds', JSON.stringify(ids));
                fd.append('isEventWide', String(isEventWide));
                fd.append('fullName', fullName);
                fd.append('course', course);
                fd.append('shift', shift);
                fd.append('phase', String(phase));
                fd.append('formResponses', JSON.stringify(formResponses));
                for (const [idx, file] of Object.entries(fileMap)) {
                    fd.append('file_' + idx, file);
                }
                res = await fetch(baseUrl + '/Home/SubmitPreRegistration', {
                    method: 'POST',
                    body: fd
                });
            } else {
                res = await fetch(baseUrl + '/Home/SubmitPreRegistration', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        email: currentEmail,
                        lectureIds: ids,
                        isEventWide,
                        fullName,
                        course,
                        shift,
                        phase,
                        formResponses
                    })
                });
            }
            const data = await res.json();
            if (data.success) {
                document.getElementById('otpEmailDisplay').textContent = currentEmail;
                document.getElementById('otpInput').value = '';
                document.getElementById('otpMsg').innerHTML = '';
                showStep('Otp');
                setTimeout(() => document.getElementById('otpInput').focus(), 100);
            } else {
                showFormMsg(data.message, 'error');
                btn.classList.remove('is-loading'); btn.disabled = false;
            }
        } catch {
            showFormMsg('Erro de conexão.', 'error');
            btn.classList.remove('is-loading'); btn.disabled = false;
        }
    }

    async function verifyOtp() {
        const code = document.getElementById('otpInput').value.trim();
        if (code.length !== 6) { document.getElementById('otpMsg').innerHTML = '<div class="msg-error">Digite o código de 6 dígitos.</div>'; return; }
        const btn = document.getElementById('btnVerifyOtp');
        btn.classList.add('is-loading'); btn.disabled = true;
        document.getElementById('otpMsg').innerHTML = '';
        const endpoint = isEventWide ? '/Home/VerifyEventPreRegistration' : '/Home/VerifyPreRegistration';
        try {
            const res = await fetch(baseUrl + endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: currentEmail, code })
            });
            const data = await res.json();
            if (data.success) {
                clearMessage();
                document.getElementById('successMessage').textContent = data.message;
                showStep('Success');
            } else {
                document.getElementById('otpMsg').innerHTML = `<div class="msg-error">${data.message}</div>`;
                btn.classList.remove('is-loading'); btn.disabled = false;
            }
        } catch {
            document.getElementById('otpMsg').innerHTML = '<div class="msg-error">Erro de conexão.</div>';
            btn.classList.remove('is-loading'); btn.disabled = false;
        }
    }

    function goBackToEmail() { clearMessage(); showStep('Email'); }
    function goBackToSchedule() {
        showStep('Schedule');
        if (isEventWide) {
            document.getElementById('btnSubmit').style.display = 'none';
        } else {
            document.getElementById('btnSubmit').style.display = '';
            updateSubmitBtn();
        }
    }
    function goBackToForm() {
        showStep('Form');
        document.getElementById('otpInput').value = '';
        document.getElementById('otpMsg').innerHTML = '';
    }

    function resetForm() {
        clearMessage();
        currentEmail = '';
        selectedIds = {};
        allLectures = [];
        activeDay = null;
        isEventWide = false;
        hasEventWideRegistration = false;
        preRegConfig = null;
        document.getElementById('emailInput').value = '';
        document.getElementById('fullNameInput').value = '';
        document.getElementById('courseSelect').value = '';
        document.getElementById('shiftSelect').value = '';
        document.getElementById('phaseSelect').value = '';
        document.getElementById('otpInput').value = '';
        document.getElementById('otpMsg').innerHTML = '';
        document.getElementById('btnSubmit').style.display = '';
        document.getElementById('btnSubmit').disabled = true;
        document.getElementById('btnSubmit').textContent = 'Avançar';
        document.getElementById('customFormArea').style.display = 'none';
        document.getElementById('customFormArea').innerHTML = '';
        showStep('Email');
    }

    document.getElementById('emailInput').addEventListener('keydown', e => { if (e.key === 'Enter') loadScheduleWithEmail(); });
    document.getElementById('otpInput').addEventListener('keydown', e => { if (e.key === 'Enter') verifyOtp(); });
    document.getElementById('otpInput').addEventListener('input', e => { e.target.value = e.target.value.replace(/\D/g, '').slice(0, 6); });
</script>
}
