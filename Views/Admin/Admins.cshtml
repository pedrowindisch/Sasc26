@{
    ViewData["Title"] = "Gerenciar Administradores";
    Layout = null;
    var ev = ViewBag.Event as Sasc26.Models.Event;
    var primaryColor = ev?.PrimaryColor ?? "#113D76";
    var accentColor = ev?.AccentColor ?? "#2EBDEF";
    var backgroundColor = ev?.BackgroundColor ?? "#f5f5f5";
    var eventSlug = ev?.Slug ?? "";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SASC 26</title>
    <link rel="stylesheet" href="~/css/bulmaswatch.min.css">
    <link rel="stylesheet" href="~/css/admin-responsive.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: @backgroundColor; min-height: 100vh; }
        .main-content { max-width: 800px; padding: 24px 16px; }
        .panel-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); padding: 24px; margin-bottom: 20px; }
        .panel-card h2 { font-size: 0.95rem; font-weight: 700; color: #1a1a1a; margin: 0 0 16px; }
        .input:focus { border-color: @accentColor; box-shadow: 0 0 0 3px rgba(46,189,239,0.15); }
        .button.is-brand { background-color: #fff; color: @primaryColor; }
        .button.is-brand:hover { background-color: #f0f0f0; color: @primaryColor; }
        .button.is-danger-light { background: #fff; color: #dc2626; border: 1px solid #dc2626; }
        .button.is-danger-light:hover { background: #dc2626; color: #fff; }
        .table { font-size: 0.82rem; }
        .table th { font-weight: 600; color: #555; }
        .msg-success { background: #ecfdf5; color: #047857; padding: 10px 14px; border-radius: 8px; font-size: 0.85rem; margin-bottom: 12px; }
        .msg-error { background: #fef2f2; color: #b91c1c; padding: 10px 14px; border-radius: 8px; font-size: 0.85rem; margin-bottom: 12px; }
        .empty-state { text-align: center; padding: 24px; color: #bbb; font-size: 0.85rem; }
    </style>
</head>
<body>
    @await Html.PartialAsync("_AdminNav")

    <div class="main-content">
        <div class="panel-card">
            <h2>Administradores do Evento</h2>
            <div id="adminMsg"></div>
            <div id="adminList" style="margin-bottom:12px;"></div>
            <div style="display:flex;gap:8px;align-items:center;">
                <input class="input" type="email" id="newAdminEmail" placeholder="admin@exemplo.com" style="max-width:300px;">
                <button class="button is-brand" onclick="addAdmin()">Adicionar</button>
            </div>
        </div>

        <div style="text-align:center;margin-top:16px;">
            <a href="/@eventSlug/Admin/Dashboard" style="font-size:0.8rem;color:#aaa;">&#8592; Voltar ao painel</a>
        </div>
    </div>

    <script>
        const baseUrl = '/@eventSlug';
        function showMsg(id, t, type) { document.getElementById(id).innerHTML = `<div class="msg-${type}">${t}</div>`; }
        function esc(s) { const d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }

        async function loadAdmins() {
            const res = await fetch(baseUrl + '/Admin/GetAdmins');
            const data = await res.json();
            if (!data.success || !data.admins) return;
            const container = document.getElementById('adminList');
            if (data.admins.length === 0) {
                container.innerHTML = '<div class="empty-state">Nenhum administrador.</div>';
                return;
            }
            let html = '<table class="table is-fullwidth is-striped"><tbody>';
            for (const email of data.admins) {
                html += `<tr>
                    <td style="vertical-align:middle;">${esc(email)}</td>
                    <td style="width:80px;text-align:right;"><button class="button is-danger-light is-small" onclick="removeAdmin('${esc(email)}')">Remover</button></td>
                </tr>`;
            }
            html += '</tbody></table>';
            container.innerHTML = html;
        }

        async function addAdmin() {
            const email = document.getElementById('newAdminEmail').value.trim();
            if (!email) { showMsg('adminMsg', 'Informe um e-mail.', 'error'); return; }
            const res = await fetch(baseUrl + '/Admin/AddAdmin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
            const data = await res.json();
            if (data.success) {
                showMsg('adminMsg', data.message, 'success');
                document.getElementById('newAdminEmail').value = '';
                loadAdmins();
            } else {
                showMsg('adminMsg', data.message || 'Erro.', 'error');
            }
        }

        async function removeAdmin(email) {
            if (!confirm(`Remover ${email} dos administradores?`)) return;
            const res = await fetch(baseUrl + '/Admin/RemoveAdmin', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) });
            const data = await res.json();
            if (data.success) {
                showMsg('adminMsg', data.message, 'success');
                loadAdmins();
            } else {
                showMsg('adminMsg', data.message || 'Erro.', 'error');
            }
        }

        loadAdmins();
    </script>
</body>
</html>
