@{
    ViewData["Title"] = "Certificados Emitidos";
    Layout = null;
    var ev = ViewBag.Event as Sasc26.Models.Event;
    var primaryColor = ev?.PrimaryColor ?? "#113D76";
    var accentColor = ev?.AccentColor ?? "#2EBDEF";
    var backgroundColor = ev?.BackgroundColor ?? "#f5f5f5";
    var eventName = ev?.Name ?? "SASC 26";
    var eventSlug = ev?.Slug ?? "";
    var certificates = ViewBag.Certificates as List<Sasc26.Models.IssuedCertificateDto> ?? new();
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SASC 26</title>
    <link rel="stylesheet" href="~/css/bulmaswatch.min.css">
    <link rel="stylesheet" href="~/css/admin-responsive.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: @backgroundColor; min-height: 100vh; }
        .main-content { max-width: 1000px; padding: 24px 16px; }
        .panel-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); padding: 24px; margin-bottom: 20px; }
        .panel-card h2 { font-size: 0.95rem; font-weight: 700; color: #1a1a1a; margin: 0 0 16px; }
        .table { font-size: 0.82rem; }
        .table th { font-weight: 600; color: #555; }
        .badge { display: inline-block; padding: 2px 10px; border-radius: 100px; font-size: 0.7rem; font-weight: 600; background: #ecfdf5; color: #059669; }
        .empty-state { text-align: center; padding: 24px; color: #bbb; font-size: 0.85rem; }
        .button.is-brand { background-color: #fff; color: @primaryColor; }
        .button.is-brand:hover { background-color: #f0f0f0; color: @primaryColor; }
        .button.is-outlined-brand { background-color: transparent; color: @primaryColor; border: 1px solid @primaryColor; }
        .button.is-outlined-brand:hover { background-color: @primaryColor; color: #fff; }
    </style>
</head>
<body>
    @await Html.PartialAsync("_AdminNav")

    <div class="main-content">
        <div class="panel-card">
            <h2>Certificados Emitidos</h2>
            @if (certificates.Count == 0)
            {
                <div class="empty-state">Nenhum certificado emitido ainda.</div>
            }
            else
            {
                <div class="table-container">
                <table class="table is-fullwidth is-hoverable is-striped">
                    <thead><tr><th>Nome</th><th>E-mail</th><th>Curso</th><th>Fase</th><th>Horas</th><th>Código</th><th>Emitido em</th></tr></thead>
                    <tbody>
                        @foreach (var c in certificates)
                        {
                            <tr>
                                <td><strong>@c.Name</strong></td>
                                <td>@c.Email</td>
                                <td>@c.Course</td>
                                <td>@c.Phase</td>
                                <td>@c.TotalHours</td>
                                <td style="font-family:monospace;font-size:0.78rem;">@c.ValidationCode</td>
                                <td>@c.IssuedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>
    </div>
</body>
</html>