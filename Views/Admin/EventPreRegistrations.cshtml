@{
    ViewData["Title"] = "Inscrições por Evento";
    Layout = null;
    var ev = ViewBag.Event as Sasc26.Models.Event;
    var primaryColor = ev?.PrimaryColor ?? "#113D76";
    var accentColor = ev?.AccentColor ?? "#2EBDEF";
    var backgroundColor = ev?.BackgroundColor ?? "#f5f5f5";
    var eventName = ev?.Name ?? "SASC 26";
    var eventSlug = ev?.Slug ?? "";
    var entries = ViewBag.Entries as List<Sasc26.Services.PreRegistrationEntryDto> ?? new();
    var submissionsByEmail = ViewBag.SubmissionsByEmail as Dictionary<string, Sasc26.Models.PreRegistrationFormSubmissionDto> ?? new();
    var formFields = ViewBag.FormFields as List<Sasc26.Models.FormFieldDto> ?? new();
    var formFiles = ViewBag.FormFiles as Dictionary<string, Sasc26.Models.FormFileAttachment> ?? new();
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SASC 26</title>
    <link rel="stylesheet" href="~/css/bulmaswatch.min.css">
    <link rel="stylesheet" href="~/css/admin-responsive.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: @backgroundColor; min-height: 100vh; }
        .main-content { max-width: 700px; padding: 24px 16px; }
        .panel-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); padding: 24px; margin-bottom: 20px; }
        .panel-card h2 { font-size: 0.95rem; font-weight: 700; color: #1a1a1a; margin: 0 0 4px; }
        .panel-card .subtitle { font-size: 0.8rem; color: #888; margin: 0 0 16px; }
        .table { font-size: 0.82rem; }
        .table th { font-weight: 600; color: #555; }
        .button.is-brand { background-color: #fff; color: @primaryColor; }
        .button.is-brand:hover { background-color: #f0f0f0; color: @primaryColor; }
        .button.is-outlined-brand { background-color: transparent; color: @primaryColor; border: 1px solid @primaryColor; }
        .button.is-outlined-brand:hover { background-color: @primaryColor; color: #fff; }
        .stat-row { display: flex; gap: 12px; margin-bottom: 16px; flex-wrap: wrap; }
        .stat-box { background: #f8faff; border-radius: 8px; padding: 12px 16px; flex: 1; min-width: 120px; text-align: center; border: 1px solid #e0e4f0; }
        .stat-box .num { font-size: 1.3rem; font-weight: 700; color: @primaryColor; }
        .stat-box .lbl { font-size: 0.65rem; color: #999; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 2px; }
        .empty-state { text-align: center; padding: 32px; color: #bbb; font-size: 0.85rem; }
        .actions { display: flex; gap: 8px; margin-bottom: 16px; }
        .copied-toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: @primaryColor; color: #fff; padding: 10px 20px; border-radius: 8px; font-size: 0.85rem; opacity: 0; transition: opacity 0.3s; pointer-events: none; }
        .copied-toast.show { opacity: 1; }
    </style>
</head>
<body>
    @await Html.PartialAsync("_AdminNav")

    <div class="main-content">
        <div class="panel-card">
            <h2>@eventName</h2>
            <p class="subtitle">Pré-inscrição por evento</p>

            <div class="stat-row">
                <div class="stat-box"><div class="num">@entries.Count</div><div class="lbl">Inscritos</div></div>
                <div class="stat-box"><div class="num">@entries.Count(e => e.AttendeeEmail.EndsWith("@@furb.br", StringComparison.OrdinalIgnoreCase))</div><div class="lbl">@@furb.br</div></div>
                <div class="stat-box"><div class="num">@entries.Count(e => !e.AttendeeEmail.EndsWith("@@furb.br", StringComparison.OrdinalIgnoreCase))</div><div class="lbl">Externo</div></div>
            </div>

            <div class="actions">
                <button class="button is-outlined-brand is-small" onclick="copyEmails()">Copiar e-mails</button>
                <a href="/@eventSlug/Admin/ExportEventPreRegistrationsCsv" class="button is-outlined-brand is-small">Exportar CSV</a>
                <a href="/@eventSlug/Admin/PreRegFormSubmissions" class="button is-outlined-brand is-small">Ver respostas do formulário</a>
            </div>

            @if (entries.Count == 0)
            {
                <div class="empty-state">Nenhum inscrito ainda.</div>
            }
            else
            {
                <div class="table-container">
                <table class="table is-fullwidth is-hoverable is-striped">
                    <thead><tr><th>#</th><th>E-mail</th><th>Data de inscrição</th>
                        @foreach (var f in formFields)
                        {
                            <th>@f.Label</th>
                        }
                    </tr></thead>
                    <tbody>
                        @{
                            int idx = 1;
                        }
                        @foreach (var e in entries)
                        {
                            var key = e.AttendeeEmail.Trim().ToLowerInvariant();
                            submissionsByEmail.TryGetValue(key, out var sub);
                            <tr>
                                <td>@idx</td>
                                <td>@e.AttendeeEmail</td>
                                <td>@e.RegisteredAt.ToString("dd/MM/yyyy HH:mm")</td>
                                @foreach (var f in formFields)
                                {
                                    var resp = sub?.Responses?.FirstOrDefault(r => r.Label == f.Label);
                                    var val = resp?.Value ?? "";
                                    if (f.Type == "arquivo" && Guid.TryParse(val, out var gid) && formFiles.TryGetValue(gid.ToString(), out var ff))
                                    {
                                        <td><a href="/@eventSlug/Admin/DownloadFormFile?id=@gid" target="_blank">@ff.FileName</a></td>
                                    }
                                    else if (f.Type == "arquivo" && !string.IsNullOrWhiteSpace(val))
                                    {
                                        <td style="color:#bbb;">(arquivo não encontrado)</td>
                                    }
                                    else
                                    {
                                        <td>@val</td>
                                    }
                                }
                            </tr>
                            idx++;
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>

        <div style="text-align:center;">
            <a href="/@eventSlug/Admin/Dashboard" style="font-size:0.8rem;color:#aaa;">&#8592; Voltar ao Dashboard</a>
        </div>
    </div>

    <div class="copied-toast" id="toast">E-mails copiados!</div>

    <script>
        function copyEmails() {
            const emails = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(entries.Select(e => e.AttendeeEmail).ToList()));
            navigator.clipboard.writeText(emails.join('\n')).then(() => {
                const toast = document.getElementById('toast');
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 2000);
            });
        }
    </script>
</body>
</html>
