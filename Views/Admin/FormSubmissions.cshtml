@{
    ViewData["Title"] = "Inscrições do Formulário";
    Layout = null;
    var ev = ViewBag.Event as Sasc26.Models.Event;
    var primaryColor = ev?.PrimaryColor ?? "#113D76";
    var accentColor = ev?.AccentColor ?? "#2EBDEF";
    var backgroundColor = ev?.BackgroundColor ?? "#f5f5f5";
    var eventName = ev?.Name ?? "SASC 26";
    var eventSlug = ev?.Slug ?? "";
    var submissions = ViewBag.Submissions as List<Sasc26.Models.FormSubmissionDto> ?? new();
    var formFields = ViewBag.FormFields as List<Sasc26.Models.FormFieldDto> ?? new();
    var formFiles = ViewBag.FormFiles as Dictionary<string, Sasc26.Models.FormFileAttachment> ?? new();
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SASC 26</title>
    <link rel="stylesheet" href="~/css/bulmaswatch.min.css">
    <link rel="stylesheet" href="~/css/admin-responsive.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: @backgroundColor; min-height: 100vh; }
        .main-content { max-width: 1200px; padding: 24px 16px; }
        .panel-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.06); padding: 24px; margin-bottom: 20px; }
        .panel-card h2 { font-size: 0.95rem; font-weight: 700; color: #1a1a1a; margin: 0 0 16px; }
        .button.is-brand { background-color: #fff; color: @primaryColor; }
        .button.is-brand:hover { background-color: #f0f0f0; color: @primaryColor; }
        .table { font-size: 0.82rem; }
        .table th { font-weight: 600; color: #555; }
        .empty-state { text-align: center; color: #aaa; padding: 40px 0; }
    </style>
</head>
<body>
    @await Html.PartialAsync("_AdminNav")

    <div class="main-content">
        <div class="panel-card">
            <h2>@submissions.Count inscrições</h2>
            @if (submissions.Count == 0)
            {
                <div class="empty-state">Nenhuma inscrição ainda.</div>
            }
            else
            {
                <div style="overflow-x:auto;">
                    <table class="table is-fullwidth is-striped">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>E-mail</th>
                                <th>Data</th>
                                @foreach (var f in formFields)
                                {
                                    <th>@f.Label</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in submissions)
                            {
                                <tr>
                                    <td>@s.Id</td>
                                    <td>@s.AttendeeEmail</td>
                                    <td>@s.SubmittedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    @foreach (var f in formFields)
                                    {
                                        var resp = s.Responses?.FirstOrDefault(r => r.Label == f.Label);
                                        var val = resp?.Value ?? "";
                                        if (f.Type == "arquivo" && Guid.TryParse(val, out var gid) && formFiles.TryGetValue(gid.ToString(), out var ff))
                                        {
                                            <td><a href="/@eventSlug/Admin/DownloadFormFile?id=@gid" target="_blank">@ff.FileName</a></td>
                                        }
                                        else
                                        {
                                            <td>@val</td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</body>
</html>