@{
    var ev = ViewBag.Event as Sasc26.Models.Event;
    var primaryColor = ev?.PrimaryColor ?? "#113D76";
    var accentColor = ev?.AccentColor ?? "#2EBDEF";
    var backgroundColor = ev?.BackgroundColor ?? "#f5f5f5";
    var textColor = ev?.TextColor ?? "#1a1a1a";
    var eventName = ev?.Name ?? "SASC 26";
    var eventSlug = ev?.Slug ?? "";
    var bgDesktop = ev?.BackgroundDesktopUrl(Url);
    var bgMobile = ev?.BackgroundMobileUrl(Url);
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @eventName</title>
    <link rel="stylesheet" href="~/css/bulmaswatch.min.css">
    <style>
        :root {
            --event-primary: @primaryColor;
            --event-accent: @accentColor;
            --event-bg: @backgroundColor;
            --event-text: @textColor;
        }
    </style>
    @if (!string.IsNullOrEmpty(bgDesktop) || !string.IsNullOrEmpty(bgMobile))
    {
        var bgInitial = !string.IsNullOrEmpty(bgDesktop) ? bgDesktop : bgMobile;
        <style>
            .event-bg {
                background-image: url('@bgInitial');
                background-size: cover;
                background-position: center;
            }
            @if (!string.IsNullOrEmpty(bgMobile))
            {
                <text>@@media (max-width: 768px) {
                    .event-bg { background-image: url('@bgMobile'); }
                }</text>
            }
        </style>
    }
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (!string.IsNullOrEmpty(bgDesktop) || !string.IsNullOrEmpty(bgMobile))
    {
        <div class="event-bg" aria-hidden="true" style="position:fixed;inset:0;z-index:0;">
            <div style="position:absolute;inset:0;background:rgba(0,0,0,0.35);"></div>
        </div>
    }
    <div style="position:relative;z-index:1;width:100%;min-height:100vh;display:flex;align-items:center;justify-content:center;">
        @RenderBody()
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
